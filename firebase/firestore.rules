rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /helpPosts/{postId} {
      // 投稿一覧はログイン済みユーザーだけが読める。
      allow read: if request.auth != null;

      // 投稿者の UID は、必ず Firebase Authentication の本人と一致させる。
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.acceptedHelperUid == null
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'category', 'type', 'locationHint',
          'requesterFeature', 'status', 'acceptedHelperUid', 'authorUid',
          'authorName', 'authorPhotoUrl', 'createdAt', 'updatedAt'
        ]);

      // 投稿者は自分の投稿を編集・削除できる。
      allow update: if request.auth != null
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']);
      allow delete: if request.auth != null
        && resource.data.authorUid == request.auth.uid;

      // 募集中の投稿は、投稿者以外のログイン済みユーザーが1人だけ引き受けられる。
      allow update: if request.auth != null
        && resource.data.authorUid != request.auth.uid
        && resource.data.status == 'open'
        && resource.data.acceptedHelperUid == null
        && request.resource.data.status == 'matched'
        && request.resource.data.acceptedHelperUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'acceptedHelperUid', 'acceptedAt']);

      // 投稿に担当者が決まると、その2人だけが会話を利用できる。
      match /messages/{messageId} {
        function isParticipant() {
          let post = get(/databases/$(database)/documents/helpPosts/$(postId)).data;
          return request.auth != null
            && post.acceptedHelperUid is string
            && (post.authorUid == request.auth.uid
              || post.acceptedHelperUid == request.auth.uid);
        }

        allow read: if isParticipant();
        allow create: if isParticipant()
          && get(/databases/$(database)/documents/helpPosts/$(postId)).data.status == 'matched'
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.text.matches('[\\s\\S]*[^\\s][\\s\\S]*')
          && request.resource.data.createdAt == request.time;
        // 送信済みメッセージの編集・削除は許可しない。
      }

      // 詳しい場所は、投稿者または引き受けた人だけが読める。
      match /private/{privateDocument} {
        allow read: if request.auth != null
          && (get(/databases/$(database)/documents/helpPosts/$(postId)).data.authorUid == request.auth.uid
            || get(/databases/$(database)/documents/helpPosts/$(postId)).data.acceptedHelperUid == request.auth.uid);

        // 投稿を作るときに、投稿者が同時に場所情報を保存する。
        allow create: if request.auth != null
          && getAfter(/databases/$(database)/documents/helpPosts/$(postId)).data.authorUid == request.auth.uid;

        allow update, delete: if request.auth != null
          && get(/databases/$(database)/documents/helpPosts/$(postId)).data.authorUid == request.auth.uid;
      }
    }

    match /userProfiles/{userId} {
      // マイページの回数・評価は本人だけが読める。
      allow read: if request.auth != null && request.auth.uid == userId;

      // 初回はすべて 0 から始める。
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.helpedCount == 0
        && request.resource.data.helpedByCount == 0
        && request.resource.data.ratingSum == 0
        && request.resource.data.ratingCount == 0;

      // 回数の更新は、ログイン中の本人に限る。
      allow update: if request.auth != null && request.auth.uid == userId;
    }
  }
}
